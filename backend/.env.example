PORT=80

DATABASE_URL="postgresql://user_postgre:password_postgre@localhost:5432/inface_db"

JWT_ACCESS_SECRET=idealmente_un_string_largo_y_seguro_para_firmar_tokens_de_acceso
JWT_REFRESH_SECRET=idealmente_un_string_largo_y_seguro_para_firmar_tokens_de_refresco

# Orígenes del frontend permitidos, separados por coma (sin "/" al final)
# Desarrollo: http://localhost:5173
# Producción: la URL con la que se abre el frontend, ej: https://inface.ubiobio.cl
CORS_ORIGIN=http://localhost:5173
# URL con la que los usuarios abren el frontend (la usan los enlaces de los correos). Sin "/" al final
FRONTEND_URL=http://localhost:5173

# Correo que envía los mensajes (recuperación de contraseña). Ejemplo con Gmail:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu.correo@gmail.com,
# SMTP_PASS=contraseña de aplicación de 16 letras (NO la de tu cuenta), SMTP_FROM=InFACE <tu.correo@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM