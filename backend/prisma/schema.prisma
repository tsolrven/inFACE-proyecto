generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// ENTIDADES BASE (compartidas por todos los módulos)
//───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

model Usuario {
  id             String   @id @default(uuid())
  correo         String   @unique
  contrasena     String
  rol            String   @default("estudiante")
  esta_activo    Boolean  @default(true)
  version_token  Int      @default(0)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  terminos_version                String?   @db.VarChar(20)
  terminos_aceptados_en           DateTime?
  consentimiento_investigacion    Boolean   @default(false)
  consentimiento_investigacion_en DateTime?

  eliminacion_programada_en DateTime?
  anonimizado_en            DateTime?

  // RELACIONES
  perfil           Perfil?
  usuario_carrera  UsuarioCarrera[]
  apuntes          Apunte[]
  comentarios            Comentario[] @relation("ComentarioAutor")
  comentarios_eliminados Comentario[] @relation("ComentarioEliminadoPor")
  votos            Voto[]
  guardados        Guardado[]
  reportes_creados Reporte[]  @relation("ReporteCreadoPor")
  reportes_revisados Reporte[] @relation("ReporteRevisadoPor")
  sanciones_recibidas  Sancion[] @relation("SancionRecibida")
  sanciones_aplicadas  Sancion[] @relation("SancionAplicada")
  sanciones_revocadas  Sancion[] @relation("SancionRevocada")
  acciones_admin       AccionAdmin[] @relation("AccionAdminAutor")
  acciones_recibidas   AccionAdmin[] @relation("AccionAdminAfectado")
  cargos_asignados     AsignacionRol[] @relation("AsignacionUsuario")
  cargos_aprobados     AsignacionRol[] @relation("AsignacionAprobada")
  cargos_revocados     AsignacionRol[] @relation("AsignacionRevocada")
  solicitudes_rol      SolicitudRol[] @relation("SolicitudUsuario")
  solicitudes_resueltas SolicitudRol[] @relation("SolicitudResuelta")
  usuario_etiquetas    UsuarioEtiqueta[]
  proyectos_creados    Proyecto[]
  postulaciones        PostulacionProyecto[]
  integrantes_proyecto IntegranteProyecto[]
  favoritos_proyecto   FavoritoProyecto[]
  descartes_proyecto   DescarteProyecto[]
  hilos Hilo[]
  anuncios Anuncio[]
  notificaciones Notificacion[]
  tokens_recuperacion TokenRecuperacion[]
  obras                  Obra[]
  productos              Producto[]

  @@map("usuarios")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Perfil {
  id              String   @id @default(uuid())
  usuario_id      String   @unique
  nombre_usuario  String   @unique
  nombre_completo String?
  biografia       String?
  campus          String?  @db.VarChar(12)
  cargo           String?  @db.VarChar(20)
  avatar          Json?
  creado_en       DateTime @default(now())
  actualizado_en  DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("perfiles")
}

//───────────────────────────────────────────────────────────────────────────────
// ETIQUETAS
//───────────────────────────────────────────────────────────────────────────────

model TipoEtiqueta {
  id                   String @id @default(uuid())
  nombre_tipo_etiqueta String @unique @db.VarChar(30)

  etiquetas Etiqueta[]

  @@map("tipos_etiqueta")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Etiqueta {
  id                    String   @id @default(uuid())
  tipo_etiqueta_id      String
  creada_por_usuario_id String?
  nombre_etiqueta       String   @unique @db.VarChar(100)
  nombre_normalizado    String   @db.VarChar(100)
  descripcion           String?
  aliases               String?
  es_predeterminada     Boolean  @default(false)
  estado                String   @default("pendiente") @db.VarChar(20)
  fecha_creacion        DateTime @default(now())

  tipo_etiqueta      TipoEtiqueta       @relation(fields: [tipo_etiqueta_id], references: [id])
  usuario_etiquetas  UsuarioEtiqueta[]
  proyecto_etiquetas ProyectoEtiqueta[]

  @@map("etiquetas")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model UsuarioEtiqueta {
  usuario_id  String
  etiqueta_id String
  nivel       String? @db.VarChar(20)

  usuario  Usuario  @relation(fields: [usuario_id], references: [id])
  etiqueta Etiqueta @relation(fields: [etiqueta_id], references: [id])

  @@id([usuario_id, etiqueta_id])
  @@map("usuario_etiquetas")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Carrera {
  id          String  @id @default(uuid())
  nombre      String
  codigo      String  @unique
  descripcion String?

  usuario_carrera UsuarioCarrera[]
  ramo_carrera    RamoCarrera[]
  anuncios        Anuncio[]
  flairs          Flair[]
  asignaciones_rol AsignacionRol[]
  solicitudes_rol  SolicitudRol[]

  @@map("carreras")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Ramo {
  id          String  @id @default(uuid())
  nombre      String
  codigo      String  @unique
  semestre    Int?
  descripcion String?

  ramo_carrera RamoCarrera[]
  apuntes      Apunte[]
  hilos        Hilo[]

  @@map("ramos")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Hashtag {
  id        String   @id @default(uuid())
  nombre    String   @unique
  creado_en DateTime @default(now())

  apuntes ApunteHashtag[]
  hilos HiloHashtag[]
  anuncios AnuncioHashtag[]
  obras   ObraHashtag[]

  @@map("hashtags")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model UsuarioCarrera {
  usuario_id   String
  carrera_id   String
  anio_ingreso Int?

  usuario Usuario @relation(fields: [usuario_id], references: [id])
  carrera Carrera @relation(fields: [carrera_id], references: [id])

  @@id([usuario_id, carrera_id])
  @@map("usuarios_carreras")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model RamoCarrera {
  ramo_id    String
  carrera_id String

  ramo    Ramo    @relation(fields: [ramo_id], references: [id])
  carrera Carrera @relation(fields: [carrera_id], references: [id])

  @@id([ramo_id, carrera_id])
  @@map("ramos_carreras")
}

//──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// TABLAS POLIMÓRFICAS UNIFICADAS
//──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

model Comentario {
  id               String    @id @default(uuid())
  autor_id         String
  tipo_contenido   String
  contenido_id     String
  padre_id         String?
  nivel            Int       @default(0)
  contenido        String
  votos_neto       Int       @default(0)
  hilo_aceptado    Hilo?     @relation("HiloRespuestaAceptada")
  eliminado        Boolean   @default(false)
  eliminado_por_id String?
  eliminado_en     DateTime?
  creado_en        DateTime  @default(now())
  actualizado_en   DateTime  @updatedAt
  editado_en       DateTime?

  autor      Usuario      @relation("ComentarioAutor", fields: [autor_id], references: [id])
  eliminador Usuario?     @relation("ComentarioEliminadoPor", fields: [eliminado_por_id], references: [id])
  padre      Comentario?  @relation("ComentarioRespuesta", fields: [padre_id], references: [id])
  respuestas Comentario[] @relation("ComentarioRespuesta")

  @@index([tipo_contenido, contenido_id, padre_id, creado_en])
  @@index([tipo_contenido, contenido_id, padre_id, votos_neto])
  @@index([padre_id, creado_en])
  @@index([padre_id, votos_neto])
  @@index([autor_id])
  @@map("comentarios")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Voto {
  usuario_id     String
  tipo_contenido String
  contenido_id   String
  tipo           String
  creado_en      DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@id([usuario_id, tipo_contenido, contenido_id])
  @@index([tipo_contenido, contenido_id])
  @@map("votos")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Guardado {
  usuario_id     String
  tipo_contenido String
  contenido_id   String
  creado_en      DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@id([usuario_id, tipo_contenido, contenido_id])
  @@index([tipo_contenido, contenido_id])
  @@map("guardados")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Archivo {
  id                 String  @id @default(uuid())
  tipo_contenido     String
  contenido_id       String
  nombre_archivo     String
  ruta_url           String
  tipo_mime          String?
  tamanio            Int?
  contador_descargas Int     @default(0)

  @@index([tipo_contenido, contenido_id])
  @@map("archivos")
}

//───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// MÓDULO 1: REPOSITORIO DE MATERIALES 
//───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

model Apunte {
  id               String    @id @default(uuid())
  autor_id         String
  ramo_id          String
  titulo           String
  descripcion      String?
  tipo             String    @default("apunte")
  links            String[]  @default([])
  codigo_snippet   String?
  lenguaje_snippet String?
  votos_neto       Int       @default(0)
  creado_en        DateTime  @default(now())
  actualizado_en   DateTime  @updatedAt
  editado_en       DateTime?

  // RELACIONES
  autor    Usuario         @relation(fields: [autor_id], references: [id])
  ramo     Ramo            @relation(fields: [ramo_id], references: [id])
  hashtags ApunteHashtag[]

  @@index([ramo_id])
  @@index([autor_id])
  @@index([tipo])
  @@map("apuntes")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model ApunteHashtag {
  apunte_id  String
  hashtag_id String

  apunte  Apunte  @relation(fields: [apunte_id], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtag_id], references: [id])

  @@id([apunte_id, hashtag_id])
  @@index([hashtag_id])
  @@map("apuntes_hashtags")
}

//───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// MÓDULO 2: FORO POR RAMOS
//───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
model Hilo {
  id                    String        @id @default(uuid())
  autor_id              String
  ramo_id               String
  titulo                String
  contenido             String? 
  votos_neto            Int           @default(0)
  respuesta_aceptada_id String?       @unique
  creado_en             DateTime      @default(now())
  actualizado_en        DateTime      @updatedAt
  editado_en            DateTime?
  autor                 Usuario       @relation(fields: [autor_id], references: [id])
  ramo                  Ramo          @relation(fields: [ramo_id], references: [id])
  respuesta_aceptada    Comentario?   @relation("HiloRespuestaAceptada", fields: [respuesta_aceptada_id], references: [id], onDelete: SetNull)
  hashtags              HiloHashtag[]

  @@index([ramo_id, creado_en])
  @@index([ramo_id, votos_neto])
  @@index([autor_id])
  @@map("hilos")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model HiloHashtag {
  hilo_id    String
  hashtag_id String
  hilo       Hilo    @relation(fields: [hilo_id], references: [id], onDelete: Cascade)
  hashtag    Hashtag @relation(fields: [hashtag_id], references: [id])

  @@id([hilo_id, hashtag_id])
  @@index([hashtag_id])
  @@map("hilos_hashtags")
}

//───────────────────────────────────────────────────────────────────────────────
// MÓDULO 3: ANUNCIOS OFICIALES
//───────────────────────────────────────────────────────────────────────────────

model Anuncio {
  id             String    @id @default(uuid())
  autor_id       String
  carrera_id     String
  flair_id       String?
  titulo         String
  contenido      String?   // markdown
  votos_neto     Int       @default(0)
  creado_en      DateTime  @default(now())
  actualizado_en DateTime  @updatedAt
  editado_en     DateTime?

  autor    Usuario          @relation(fields: [autor_id], references: [id])
  carrera  Carrera          @relation(fields: [carrera_id], references: [id])
  flair    Flair?           @relation(fields: [flair_id], references: [id], onDelete: SetNull)
  hashtags AnuncioHashtag[]

  @@index([carrera_id, creado_en])
  @@index([carrera_id, votos_neto])
  @@index([flair_id])
  @@index([autor_id])
  @@map("anuncios")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model AnuncioHashtag {
  anuncio_id String
  hashtag_id String

  anuncio Anuncio @relation(fields: [anuncio_id], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtag_id], references: [id])

  @@id([anuncio_id, hashtag_id])
  @@index([hashtag_id])
  @@map("anuncios_hashtags")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Flair {
  id                 String   @id @default(uuid())
  carrera_id         String
  nombre             String   @db.VarChar(30)
  nombre_normalizado String   @db.VarChar(30)
  color              String   @db.VarChar(20)
  creado_en          DateTime @default(now())

  carrera  Carrera   @relation(fields: [carrera_id], references: [id])
  anuncios Anuncio[]

  @@unique([carrera_id, nombre_normalizado])
  @@map("flairs")
}
//───────────────────────────────────────────────────────────────────────────────
// MÓDULO 4: MATCH DE PROYECTOS
//───────────────────────────────────────────────────────────────────────────────

model Proyecto {
  id                   String    @id @default(uuid())
  creador_id           String
  titulo_proyecto      String    @db.VarChar(200)
  descripcion_proyecto String?
  modalidad_proyecto   String    @db.VarChar(20)
  maximo_integrantes   Int?
  estado_proyecto      String    @default("abierto") @db.VarChar(20)
  fecha_inicio         DateTime?
  fecha_fin            DateTime?
  fecha_creacion       DateTime  @default(now())
  votos_neto           Int       @default(0)

  video_url       String?
  repositorio_url String?
  linkedin_url    String?

  creador       Usuario               @relation(fields: [creador_id], references: [id])
  postulaciones PostulacionProyecto[]
  integrantes   IntegranteProyecto[]
  favoritos     FavoritoProyecto[]
  etiquetas     ProyectoEtiqueta[]
  descartes     DescarteProyecto[]

  @@map("proyectos")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model PostulacionProyecto {
  id                  String   @id @default(uuid())
  proyecto_id         String
  postulante_id       String
  mensaje_postulacion String?
  estado_postulacion  String   @default("pendiente") @db.VarChar(20)
  fecha_postulacion   DateTime @default(now())

  proyecto   Proyecto @relation(fields: [proyecto_id], references: [id])
  postulante Usuario  @relation(fields: [postulante_id], references: [id])

  @@map("postulaciones_proyecto")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model IntegranteProyecto {
  id              String    @id @default(uuid())
  proyecto_id     String
  usuario_id      String
  rol_en_proyecto String?   @db.VarChar(50)
  fecha_union     DateTime  @default(now())
  fue_expulsado   Boolean   @default(false)
  fecha_expulsion DateTime?

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id])
  usuario  Usuario  @relation(fields: [usuario_id], references: [id])

  @@map("integrantes_proyecto")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model FavoritoProyecto {
  usuario_id     String
  proyecto_id    String
  fecha_creacion DateTime @default(now())

  usuario  Usuario  @relation(fields: [usuario_id], references: [id])
  proyecto Proyecto @relation(fields: [proyecto_id], references: [id])

  @@id([usuario_id, proyecto_id])
  @@map("favoritos_proyecto")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model ProyectoEtiqueta {
  proyecto_id String
  etiqueta_id String

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id])
  etiqueta Etiqueta @relation(fields: [etiqueta_id], references: [id])

  @@id([proyecto_id, etiqueta_id])
  @@map("proyecto_etiquetas")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model DescarteProyecto {
  usuario_id     String
  proyecto_id    String
  fecha_creacion DateTime @default(now())

  usuario  Usuario  @relation(fields: [usuario_id], references: [id])
  proyecto Proyecto @relation(fields: [proyecto_id], references: [id])

  @@id([usuario_id, proyecto_id])
  @@map("descartes_proyecto")
}

// ╰─────────────────────────────✧────────────────────────────────╮

// RECOMENDADOR (clusters + señales de interacción)

model ModeloCluster {
  id           String   @id @default(uuid())
  version      String   @unique
  k            Int
  silueta      Float?
  n_usuarios   Int
  n_proyectos  Int
  etiquetas    Json
  centroides   Json
  parametros   Json?
  activo       Boolean  @default(false)
  entrenado_en DateTime @default(now())

  usuarios  ClusterUsuario[]
  proyectos ClusterProyecto[]

  @@index([activo])
  @@map("modelos_cluster")
}

model ClusterUsuario {
  modelo_id  String
  usuario_id String
  cluster    Int
  distancia  Float

  modelo ModeloCluster @relation(fields: [modelo_id], references: [id], onDelete: Cascade)

  @@id([modelo_id, usuario_id])
  @@index([usuario_id])
  @@index([modelo_id, cluster])
  @@map("cluster_usuario")
}

model ClusterProyecto {
  modelo_id   String
  proyecto_id String
  cluster     Int
  distancia   Float

  modelo ModeloCluster @relation(fields: [modelo_id], references: [id], onDelete: Cascade)

  @@id([modelo_id, proyecto_id])
  @@index([proyecto_id])
  @@map("cluster_proyecto")
}

model RecomendacionLog {
  id          String   @id @default(uuid())
  usuario_id  String
  proyecto_id String
  algoritmo   String   @db.VarChar(20)
  modelo_id   String?
  posicion    Int
  puntaje     Float
  servido_en  DateTime @default(now())

  @@unique([usuario_id, proyecto_id])
  @@index([algoritmo])
  @@map("recomendacion_log")
}

model InteraccionProyecto {
  id          String   @id @default(uuid())
  usuario_id  String
  proyecto_id String
  tipo        String   @db.VarChar(20)
  creado_en   DateTime @default(now())

  @@index([usuario_id, proyecto_id])
  @@index([creado_en])
  @@index([tipo])
  @@map("interaccion_proyecto_log")
}

//───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// MODERACIÓN 
//───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

model Reporte {
  id             String    @id @default(uuid())
  reportado_por  String
  tipo_contenido String
  contenido_id   String
  motivo         String
  detalle        String?
  estado         String    @default("pendiente") @db.VarChar(20)
  revisado_por   String?
  revisado_en    DateTime?
  creado_en      DateTime  @default(now())
  nota_resolucion         String?  @db.VarChar(500)
  respuesta_personalizada Boolean  @default(false)
  notificacion_estado     String?   @db.VarChar(20)
  notificacion_intentos   Int       @default(0)
  notificacion_error      String?   @db.VarChar(300)
  notificacion_enviada_en DateTime?
  contenido_snapshot Json?
  contenido_autor_id    String?
  oculto_por_reportante Boolean @default(false)
  eliminado_por String? @db.VarChar(20)

  reportador Usuario  @relation("ReporteCreadoPor", fields: [reportado_por], references: [id])
  revisor    Usuario? @relation("ReporteRevisadoPor", fields: [revisado_por], references: [id])

  @@index([tipo_contenido, contenido_id])
  @@index([estado, notificacion_estado])
  @@index([reportado_por])
  @@index([contenido_autor_id])
  @@map("reportes")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model Sancion {
  id         String @id @default(uuid())
  usuario_id String
  tipo       String @db.VarChar(20)
  motivo     String @db.VarChar(500)
  contenido_tipo String? @db.VarChar(30)
  contenido_id   String?

  aplicada_por String
  creado_en    DateTime @default(now())
  hasta DateTime?

  revocada_en       DateTime?
  revocada_por      String?
  motivo_revocacion String?   @db.VarChar(500)

  usuario   Usuario  @relation("SancionRecibida", fields: [usuario_id], references: [id])
  aplicador Usuario  @relation("SancionAplicada", fields: [aplicada_por], references: [id])
  revocador Usuario? @relation("SancionRevocada", fields: [revocada_por], references: [id])

  @@index([usuario_id, creado_en])
  @@map("sanciones")
}

// ╰─────────────────────────────✧────────────────────────────────╮

model AsignacionRol {
  id               String    @id @default(uuid())
  usuario_id       String
  tipo             String    @db.VarChar(10)
  carrera_id       String
  desde            DateTime  @db.Date
  hasta            DateTime  @db.Date
  aprobada_por     String?
  revocada_en      DateTime?
  revocada_por     String?
  aviso_enviado_en DateTime?
  creado_en        DateTime  @default(now())

  usuario   Usuario  @relation("AsignacionUsuario", fields: [usuario_id], references: [id])
  carrera   Carrera  @relation(fields: [carrera_id], references: [id])
  aprobador Usuario? @relation("AsignacionAprobada", fields: [aprobada_por], references: [id])
  revocador Usuario? @relation("AsignacionRevocada", fields: [revocada_por], references: [id])
  solicitud SolicitudRol?

  @@index([usuario_id, hasta])
  @@index([carrera_id, tipo])
  @@map("asignaciones_rol")
}

// ╰─────────────────────────────✧────────────────────────────────╮
// SOLICITUDES DE CARGO (CEE o tutor). 

model SolicitudRol {
  id                   String    @id @default(uuid())
  usuario_id           String
  tipo                 String    @db.VarChar(10)
  carrera_id           String
  mensaje              String    @db.VarChar(1000)
  estado               String    @default("pendiente") @db.VarChar(15)
  creado_en            DateTime  @default(now())
  resuelta_en          DateTime?
  resuelta_por         String?
  motivo_rechazo       String?   @db.VarChar(500)
  asignacion_id        String?   @unique
  archivos_borrados_en DateTime?

  usuario    Usuario        @relation("SolicitudUsuario", fields: [usuario_id], references: [id])
  carrera    Carrera        @relation(fields: [carrera_id], references: [id])
  resolutor  Usuario?       @relation("SolicitudResuelta", fields: [resuelta_por], references: [id])
  asignacion AsignacionRol? @relation(fields: [asignacion_id], references: [id])

  @@index([usuario_id, creado_en])
  @@index([estado, creado_en])
  @@map("solicitudes_rol")
}

// ╰─────────────────────────────✧────────────────────────────────╮
// NOTIFICACIONES (transversal: las usan todos los módulos con notificar())

model Notificacion {
  id         String   @id @default(uuid())
  usuario_id String
  tipo       String   @db.VarChar(50)
  titulo     String   @db.VarChar(150)
  mensaje    String?  @db.VarChar(500)
  enlace     String?  @db.VarChar(300)
  leida      Boolean  @default(false)
  creado_en  DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id, leida, creado_en])
  @@map("notificaciones")
}

// ╰─────────────────────────────✧────────────────────────────────╮
// RECUPERACIÓN DE CONTRASEÑA (el token real solo viaja por correo; aquí queda su hash)

model TokenRecuperacion {
  id         String    @id @default(uuid())
  usuario_id String
  token_hash String    @unique
  expira_en  DateTime
  usado_en   DateTime?
  creado_en  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@map("tokens_recuperacion")
}


// Códigos de verificación del correo institucional (registro). 
model VerificacionCorreo {
  correo          String   @id
  codigo_hash     String   @db.VarChar(64)
  expira_en       DateTime
  intentos        Int      @default(0)
  ultimo_envio_en DateTime @default(now())
  creado_en       DateTime @default(now())

  @@map("verificaciones_correo")
}
//───────────────────────────────────────────────────────────────────────────────
// MÓDULO: ESPACIO CREATIVO / CULTURAL
model Obra {
  id             String    @id @default(uuid())
  autor_id       String
  tipo           String
  titulo         String
  descripcion    String?
  texto          String?
  enlace_url     String?
  borrador       Boolean   @default(false)
  es_galeria     Boolean   @default(false)
  guion_id       String?
  portada_id     String?
  firma          String?
  estilo         Json?
  votos_neto     Int       @default(0)
  creado_en      DateTime  @default(now())
  actualizado_en DateTime  @updatedAt
  editado_en     DateTime?

  autor        Usuario          @relation(fields: [autor_id], references: [id])
  guion        Obra?            @relation("ObraGuion", fields: [guion_id], references: [id], onDelete: SetNull)
  adaptaciones Obra[]           @relation("ObraGuion")
  hashtags     ObraHashtag[]
  capitulos    GuionCapitulo[]
  personajes   GuionPersonaje[]
  pistas       AlbumPista[]

  @@index([tipo, creado_en])
  @@index([tipo, votos_neto])
  @@index([autor_id])
  @@index([guion_id])
  @@map("obras")
}

model ObraHashtag {
  obra_id    String
  hashtag_id String

  obra    Obra    @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtag_id], references: [id])

  @@id([obra_id, hashtag_id])
  @@index([hashtag_id])
  @@map("obras_hashtags")
}

model GuionCapitulo {
  id        String  @id @default(uuid())
  obra_id   String
  orden     Int
  titulo    String
  contenido String
  borrador  Boolean @default(false)

  obra     Obra              @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  parrafos CapituloParrafo[]

  @@index([obra_id, orden])
  @@map("guion_capitulos")
}

model GuionPersonaje {
  id          String  @id @default(uuid())
  obra_id     String
  orden       Int
  nombre      String
  descripcion String?
  imagen_id   String?

  obra Obra @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  @@index([obra_id, orden])
  @@map("guion_personajes")
}

model CapituloParrafo {
  id          String   @id @default(uuid())
  capitulo_id String
  indice      Int
  autor_id    String
  extracto    String
  votos_neto  Int      @default(0)
  creado_en   DateTime @default(now())

  capitulo GuionCapitulo @relation(fields: [capitulo_id], references: [id], onDelete: Cascade)

  @@unique([capitulo_id, indice])
  @@map("capitulo_parrafos")
}

model AlbumPista {
  id         String  @id @default(uuid())
  obra_id    String
  orden      Int
  titulo     String
  enlace_url String?
  archivo_id String?

  obra Obra @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  @@index([obra_id, orden])
  @@map("album_pistas")
}

// ╰─────────────────────────────✧────────────────────────────────╮
// MÓDULO: MARKETPLACE (compra / venta entre estudiantes)
model Producto {
  id                 String    @id @default(uuid())
  vendedor_id        String
  titulo             String
  descripcion        String?
  precio             Int
  categoria          String
  condicion          String
  estado             String    @default("disponible")
  negociable         Boolean   @default(false)
  ubicacion          String?
  unidad_precio      String?
  modalidad          String?
  entrega_domicilio  Boolean   @default(false)
  contacto_whatsapp  String?
  contacto_instagram String?
  contacto_discord   String?
  votos_neto         Int       @default(0)
  creado_en          DateTime  @default(now())
  actualizado_en     DateTime  @updatedAt
  editado_en         DateTime?

  vendedor Usuario @relation(fields: [vendedor_id], references: [id])

  @@index([estado, creado_en])
  @@index([categoria, creado_en])
  @@index([vendedor_id])
  @@map("productos")
}

// ╰─────────────────────────────✧────────────────────────────────╮
// REGISTRO DE ACCIONES ADMINISTRATIVAS (quién hizo qué y cuándo)

model AccionAdmin {
  id           String   @id @default(uuid())
  admin_id     String
  tipo         String   @db.VarChar(40)
  entidad_tipo String?  @db.VarChar(30)
  entidad_id   String?
  afectado_id  String?
  detalle      Json?
  creado_en    DateTime @default(now())

  admin    Usuario  @relation("AccionAdminAutor", fields: [admin_id], references: [id])
  afectado Usuario? @relation("AccionAdminAfectado", fields: [afectado_id], references: [id])

  @@index([creado_en])
  @@index([admin_id, creado_en])
  @@index([entidad_tipo, entidad_id])
  @@map("acciones_admin")
}